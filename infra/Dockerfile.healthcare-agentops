FROM python:3.13-slim

WORKDIR /app

COPY apps/healthcare/requirements.txt ./requirements.txt
RUN python -m pip install --no-cache-dir -r requirements.txt

COPY apps/healthcare/server.py ./server.py
COPY apps/healthcare/engine.py ./engine.py
COPY apps/healthcare/model.py ./model.py
COPY apps/healthcare/index.html ./index.html
COPY apps/frontend/src/frontend /app/source/apps/frontend/src/frontend
COPY apps/frontend/preview /app/source/apps/frontend/preview

RUN groupadd --system app && useradd --system --gid app --home-dir /app app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HEALTHOPS_SOURCE_ROOT=/app/source \
    HOST=0.0.0.0 \
    PORT=8765

USER app
EXPOSE 8765
CMD ["python", "server.py"]
